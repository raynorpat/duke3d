include("${CMAKE_CURRENT_LIST_DIR}/v13d_data.cmake")
v13d_check_edition("${DATA}" sw099)
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/run" "${WORK}/home")
file(CREATE_LINK "${DATA}/DUKE3D.GRP" "${WORK}/run/duke3d.grp" SYMBOLIC COPY_ON_ERROR)
foreach(_con GAME.CON DEFS.CON USER.CON)
  file(COPY_FILE "${DATA}/${_con}" "${WORK}/run/${_con}")
endforeach()
file(WRITE "${WORK}/run/check.route" "-31259 7191 wait 26\n-30747 7191\n")
set(ENV{SDL_VIDEODRIVER} dummy)
set(ENV{SDL_AUDIODRIVER} dummy)
set(ENV{HOME} "${WORK}/home")
set(ENV{USERPROFILE} "${WORK}/home")
set(ENV{DUKE3D_SAVE_DIR} "${WORK}/home")
if(DEMOGOD)
  set(_options -demogod)
endif()
execute_process(COMMAND "${DUKE3D}" /v1 /l1 /s3 -routebot check.route -r ${_options}
  WORKING_DIRECTORY "${WORK}/run" TIMEOUT 30 RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
if(NOT _result EQUAL 0)
  message(FATAL_ERROR "route recording failed: ${_result}\n${_out}${_err}")
endif()
string(REGEX MATCH "ROUTESTATE ([-0-9 ]+) EOL" _state "${_out}")
set(_author "${CMAKE_MATCH_1}")
if(NOT _state)
  message(FATAL_ERROR "no author state: ${_out}")
endif()
execute_process(COMMAND "${DUKE3D}" -demoverify 1 ${_options}
  WORKING_DIRECTORY "${WORK}/run" TIMEOUT 30 RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
string(REGEX MATCH "DEMOSTATE ([-0-9 ]+)" _state "${_out}")
set(_play "${CMAKE_MATCH_1}")
string(STRIP "${_play}" _play)
if(NOT _result EQUAL 0 OR NOT _play STREQUAL _author)
  message(FATAL_ERROR "route writer/reader mismatch: ${_author} / ${_play}\n${_out}${_err}")
endif()
message(STATUS "authored beta demo plays identically: ${_play}")
