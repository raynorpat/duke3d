# A short, per-build scratch path keeps the profile within the map-path limit.
string(MD5 _id "${WORK}")
string(SUBSTRING "${_id}" 0 8 _id)
if(CMAKE_HOST_WIN32)
  set(_root "$ENV{TEMP}/duke-um-${_id}")
else()
  set(_root "/tmp/duke-um-${_id}")
endif()
set(_modes empty main bulk long)
if(DEFINED GRP)
  set(_modes launch)
endif()
foreach(_mode IN LISTS _modes)
  file(REMOVE_RECURSE "${_root}")
  file(MAKE_DIRECTORY "${_root}/run/maps" "${_root}/home")
  if(CMAKE_HOST_APPLE)
    set(_profile "${_root}/home/Library/Application Support/Duke Nukem 3D")
  elseif(CMAKE_HOST_WIN32)
    set(_profile "${_root}/home/Duke Nukem 3D")
  else()
    set(_profile "${_root}/home/.duke3d")
  endif()
  file(MAKE_DIRECTORY "${_profile}/maps")
  set(_args "${_mode}")
  if(DEFINED GRP)
    foreach(_con GAME.CON DEFS.CON USER.CON)
      file(COPY_FILE "${CON_DIR}/${_con}" "${_root}/run/${_con}")
    endforeach()
    list(APPEND _args "${GRP}")
  endif()
  if(PROFILE)
    list(PREPEND _args -test-gameversion "${PROFILE}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env
    "HOME=${_root}/home" "USERPROFILE=${_root}/home" "DUKE3D_SAVE_DIR=${_root}/home"
    SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy BUILD_WINDOWED=1
    "${TEST}" ${_args}
    WORKING_DIRECTORY "${_root}/run" RESULT_VARIABLE _result
    OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  # gameexit() can return status zero; require the test's completion marker.
  if(NOT _result STREQUAL "0" OR NOT _out MATCHES "user maps menu: PASS")
    message(FATAL_ERROR "user maps menu ${_mode} failed: ${_result}\n${_out}\n${_err}")
  endif()
  if(DEFINED GRP)
    message(STATUS "${_out}")
  endif()
endforeach()
if(NOT DEFINED GRP)
  file(REMOVE_RECURSE "${_root}")
else()
  message(STATUS "Real menu capture: ${_root}/run")
endif()
