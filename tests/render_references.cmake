# Verified on unchanged 58bdcc3; see docs/render-reference-investigation.md.
# Identity comes from game_profile --identify, never from the filename.
function(duke_render_stock profile key out)
  set(_value "")
  if(profile STREQUAL "1.3d" OR profile STREQUAL "1.5")
    if(key STREQUAL "E1L1")
      if(profile STREQUAL "1.3d")
        set(_value e0517697)
      else()
        set(_value 99d777cd)
      endif()
    elseif(key STREQUAL "E1L1_TILT")
      if(profile STREQUAL "1.3d")
        set(_value 64e7f538)
      else()
        set(_value 67030c2c)
      endif()
    endif()
    foreach(_pin "320x200;9f03fd16;763b8c56;763b8c56"
                 "640x400;c6b6b632;7282abe5;b08ff175"
                 "640x480;92082500;dfe0efbe;3378e21d"
                 "1280x1024;43229c16;441cd127;e5dc3af1"
                 "480x640;6a4e30ce;28839020;28839020"
                 "1280x720;7507d7cd;cc44ab59;d99dddf4"
                 "1600x900;872652c4;cc8d7da2;ddec2065")
      list(GET _pin 0 _size)
      if(key STREQUAL "CLASSIC2D_${_size}_HUD")
        list(GET _pin 1 _value)
      elseif(key STREQUAL "CLASSIC2D_${_size}_MAP")
        if(profile STREQUAL "1.3d")
          list(GET _pin 2 _value)
        else()
          list(GET _pin 3 _value)
        endif()
      endif()
    endforeach()
  endif()
  set(${out} "${_value}" PARENT_SCOPE)
endfunction()

function(duke_render_reference profile key generic out)
  duke_render_stock("${profile}" "${key}" _value)
  set(_edition "")
  if(profile STREQUAL "1.3d")
    set(_edition 13D)
  elseif(profile STREQUAL "1.5")
    set(_edition ATOMIC)
  endif()
  if(_edition AND DEFINED DUKE3D_RENDER_${_edition}_${key}
      AND NOT DUKE3D_RENDER_${_edition}_${key} STREQUAL "stock")
    set(_value "${DUKE3D_RENDER_${_edition}_${key}}")
  endif()
  if(generic AND DEFINED DUKE3D_RENDER_GENERIC_${key}
      AND NOT DUKE3D_RENDER_GENERIC_${key} STREQUAL "stock")
    set(_value "${DUKE3D_RENDER_GENERIC_${key}}")
  endif()
  set(${out} "${_value}" PARENT_SCOPE)
endfunction()

function(duke_render_configure settings)
  set(_keys E1L1 E1L1_TILT)
  foreach(_size 320x200 640x400 640x480 1280x1024 480x640 1280x720 1600x900)
    list(APPEND _keys CLASSIC2D_${_size}_HUD CLASSIC2D_${_size}_MAP)
  endforeach()
  file(WRITE "${settings}" "# Generated rendering overrides; stock follows GRP identity.\n")
  foreach(_key IN LISTS _keys)
    if(_key STREQUAL "E1L1")
      set(_old DUKE3D_E1L1_CHECKSUM)
    elseif(_key STREQUAL "E1L1_TILT")
      set(_old DUKE3D_E1L1_TILT_CHECKSUM)
    else()
      set(_old DUKE3D_${_key})
    endif()
    duke_render_stock(1.3d "${_key}" _old_default)
    # A cached default was implicit in every old build. Only nondefault values
    # can be identified as explicit overrides, and apply only to DUKE3D_GRP.
    if(DEFINED ${_old} AND NOT "${${_old}}" STREQUAL "${_old_default}"
        AND NOT DEFINED DUKE3D_RENDER_GENERIC_${_key})
      set(DUKE3D_RENDER_GENERIC_${_key} "${${_old}}" CACHE STRING "Generic GRP checksum override")
      message(STATUS "Migrated ${_old} to DUKE3D_RENDER_GENERIC_${_key}")
    endif()
    foreach(_edition 13D ATOMIC GENERIC)
      set(_var DUKE3D_RENDER_${_edition}_${_key})
      set(${_var} stock CACHE STRING "${_edition} ${_key}: stock, hex checksum, or empty to print only")
      if(NOT "${${_var}}" STREQUAL "stock" AND NOT "${${_var}}" STREQUAL ""
          AND NOT "${${_var}}" MATCHES "^[0-9a-fA-F]+$")
        message(FATAL_ERROR "${_var} must be stock, a hex checksum, or empty")
      endif()
      file(APPEND "${settings}" "set(${_var} \"${${_var}}\")\n")
    endforeach()
  endforeach()
endfunction()
