# Exercise real gameplay EOL, ending rendering, queued keys, and normal shutdown.
include("${CMAKE_CURRENT_LIST_DIR}/v13d_data.cmake")
v13d_check_edition("${DATA}" sw099)
if(NOT EXISTS "${DEMO}")
  message(FATAL_ERROR "E1L5 episode-ending demo missing: ${DEMO}")
endif()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/run" "${WORK}/home")
file(CREATE_LINK "${DATA}/DUKE3D.GRP" "${WORK}/run/duke3d.grp" SYMBOLIC COPY_ON_ERROR)
foreach(_con GAME.CON DEFS.CON USER.CON)
  file(COPY_FILE "${DATA}/${_con}" "${WORK}/run/${_con}")
endforeach()
file(COPY_FILE "${DEMO}" "${WORK}/run/demo1.dmo")
set(ENV{SDL_VIDEODRIVER} dummy)
set(ENV{SDL_AUDIODRIVER} dummy)
set(ENV{BUILD_WINDOWED} 1)
set(ENV{HOME} "${WORK}/home")
set(ENV{USERPROFILE} "${WORK}/home")
set(ENV{DUKE3D_SAVE_DIR} "${WORK}/home")
execute_process(COMMAND "${DUKE3D}" -demoverify 1 -demogod -renderer 0
  WORKING_DIRECTORY "${WORK}/run" TIMEOUT 125 RESULT_VARIABLE _result
  OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
file(WRITE "${WORK}/episode.log" "${_out}${_err}")
if(NOT _result STREQUAL "0")
  message(FATAL_ERROR "episode-ending process failed: ${_result}\n${_out}${_err}")
endif()
set(_last -1)
foreach(_marker "replay EOL level 5" "phase victory" "victory held" "phase score"
    "phase ordering0" "phase ordering1" "phase ordering2" "phase ordering3"
    "phase title" "shutdown complete")
  string(FIND "${_out}" "EPISODE ${_marker}" _where)
  if(_where LESS 0 OR _where LESS_EQUAL _last)
    message(FATAL_ERROR "missing/out-of-order ${_marker}\n${_out}${_err}")
  endif()
  set(_last ${_where})
endforeach()
string(REGEX MATCH "EPISODE victory held ([0-9]+) ms" _hold "${_out}")
if(NOT _hold OR CMAKE_MATCH_1 LESS 60000)
  message(FATAL_ERROR "victory did not run for 60 wall seconds")
endif()
foreach(_stage RANGE 0 6)
  if(NOT EXISTS "${WORK}/run/episode_${_stage}_0.ppm")
    message(FATAL_ERROR "missing rendered frame evidence for stage ${_stage}")
  endif()
endforeach()
file(GLOB_RECURSE _configs "${WORK}/home/duke3d.cfg" "${WORK}/run/duke3d.cfg")
if(NOT _configs)
  message(FATAL_ERROR "normal shutdown did not save its configuration")
endif()
message(STATUS "episode ending: 60-second victory, score, four ordering screens, title, normal shutdown")
