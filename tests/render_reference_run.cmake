include("${CMAKE_CURRENT_LIST_DIR}/render_references.cmake")
if(SETTINGS)
  include("${SETTINGS}")
endif()
execute_process(COMMAND "${IDENTIFY}" --identify "${GRP}"
  RESULT_VARIABLE _identified OUTPUT_VARIABLE _profile ERROR_VARIABLE _error
  OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT _identified EQUAL 0)
  message(FATAL_ERROR "Cannot identify render GRP: ${_error}")
endif()
set(_ref3 "")
set(_key E1L1)
if(KIND STREQUAL "tilt")
  set(_key E1L1_TILT)
elseif(KIND STREQUAL "minihud")
  set(_key NONE)
elseif(KIND STREQUAL "classic")
  set(_key CLASSIC2D_${SIZE}_HUD)
endif()
duke_render_reference("${_profile}" "${_key}" "${GENERIC}" _ref1)
set(_ref2 "")
if(KIND STREQUAL "classic")
  duke_render_reference("${_profile}" "CLASSIC2D_${SIZE}_MAP" "${GENERIC}" _ref2)
endif()
if(KIND STREQUAL "minihud" AND (_profile STREQUAL "1.3d" OR _profile STREQUAL "1.5"))
  set(_ref1 "${MINIREF1}")
  set(_ref2 "${MINIREF2}")
  set(_ref3 "${MINIREF3}")
endif()
message(STATUS "profile=${_profile} reference1=<${_ref1}> reference2=<${_ref2}>")
if(_ref1 STREQUAL "" AND _ref2 STREQUAL "")
  message(STATUS "No stock golden coverage for this GRP (or assertions explicitly disabled).")
endif()
if(QUERY_ONLY)
  return()
endif()
set(_profile_args "")
if(_profile STREQUAL "unknown" OR _profile STREQUAL "unsupported")
  if(NOT GAMEVERSION)
    message(STATUS "No rendering profile: set DUKE3D_RENDER_GAMEVERSION for modified data.")
    return()
  endif()
  set(_profile_args -test-gameversion "${GAMEVERSION}")
endif()
# Keep empty checksum arguments in place: list expansion would drop them.
if(KIND STREQUAL "classic" OR KIND STREQUAL "minihud")
  string(REPLACE "x" ";" _wh "${SIZE}")
  if(KIND STREQUAL "minihud")
    execute_process(COMMAND "${EXE}" ${_profile_args} "${GRP}" "${OUT}" ${_wh}
      "${_ref1}" "${_ref2}" "${_ref3}"
      RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  else()
    execute_process(COMMAND "${EXE}" ${_profile_args} "${GRP}" "${OUT}" ${_wh}
      "${_ref1}" "${_ref2}"
      RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  endif()
elseif(KIND STREQUAL "tilt")
  execute_process(COMMAND "${EXE}" ${_profile_args} "${GRP}" "${OUT}" "${_ref1}" 0 tilt
    RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
else()
  execute_process(COMMAND "${EXE}" ${_profile_args} "${GRP}" "${OUT}" "${_ref1}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
endif()
message(STATUS "${_out}${_err}")
if(NOT _result EQUAL 0)
  message(FATAL_ERROR "Rendering check failed: ${_result}")
endif()
