diff --git a/cmake/CompileOptions.cmake b/cmake/CompileOptions.cmake
index b11692be39346a1f48aeae4edc58e8165ede2159..fbc4fee74cf9824e46c36987c895ead65425db8f 100644
--- a/cmake/CompileOptions.cmake
+++ b/cmake/CompileOptions.cmake
@@ -25,8 +25,10 @@ endif()
 if(MSVC)
   target_compile_definitions(duke3d_compile_options INTERFACE
     _CRT_SECURE_NO_WARNINGS _CRT_NONSTDC_NO_DEPRECATE)
-  # /J: char is unsigned, which the game logic assumes.
-  target_compile_options(duke3d_compile_options INTERFACE /J /W3 /wd4996)
+  # /J: char is unsigned, which the game logic assumes. /we4311 /we4312
+  # /we4302: pointer truncation and widening casts are errors.
+  target_compile_options(duke3d_compile_options INTERFACE
+    /J /W3 /wd4996 /we4311 /we4312 /we4302)
 else()
   # The game logic assumes unsigned char, and the code relies on
   # type-punning that breaks under strict aliasing.
@@ -48,6 +50,18 @@ else()
         "-Wno-error=${_flag}")
     endif()
   endforeach()
+
+  # Casts that truncate or widen an address are errors on 64-bit targets.
+  foreach(_flag
+      pointer-to-int-cast
+      int-to-pointer-cast)
+    string(MAKE_C_IDENTIFIER "DUKE3D_HAS_WERROR_${_flag}" _var)
+    check_c_compiler_flag("-Werror=${_flag}" ${_var})
+    if(${_var})
+      target_compile_options(duke3d_compile_options INTERFACE
+        "-Werror=${_flag}")
+    endif()
+  endforeach()
 endif()
 
 target_compile_features(duke3d_compile_options INTERFACE c_std_99)
diff --git a/source/build/build.h b/source/build/build.h
index 053d328e278d35264523f1e27b13f720fc11c33c..631a59d2dcadce06bd1df17845419d6b9c8f4cc3 100644
--- a/source/build/build.h
+++ b/source/build/build.h
@@ -141,9 +141,13 @@ typedef struct
 #pragma pack()
 #endif
 
-_Static_assert(sizeof(sectortype) == 40, "sectortype must match the on-disk size");
-_Static_assert(sizeof(walltype) == 32, "walltype must match the on-disk size");
-_Static_assert(sizeof(spritetype) == 44, "spritetype must match the on-disk size");
+/* A C99 compile-time check: the array size is negative when c is false. */
+#define BUILD_STATIC_ASSERT(c, name) typedef char build_static_assert_##name[(c) ? 1 : -1]
+
+/* These must match the on-disk sizes. */
+BUILD_STATIC_ASSERT(sizeof(sectortype) == 40, sectortype_size);
+BUILD_STATIC_ASSERT(sizeof(walltype) == 32, walltype_size);
+BUILD_STATIC_ASSERT(sizeof(spritetype) == 44, spritetype_size);
 
 EXTERN sectortype sector[MAXSECTORS];
 EXTERN walltype wall[MAXWALLS];
